# =============================================================================
# RythuDirect — environment template
#
# Copy to `.env` (server) and `client/.env` and fill in real values.
# NEVER commit a populated .env. This file contains placeholders only.
# =============================================================================

# ----------------------------------------------------------------------------
# Core (REQUIRED — the app will not start without these)
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=12001

# Owner/migration connection. Used by `npm run db:migrate` and `db:seed` only.
# The API itself never connects with this role.
DATABASE_URL=postgresql://rythu_app:CHANGE_ME@127.0.0.1:5432/rythudirect

# Least-privilege runtime connection. Every request runs through this role,
# which has NOBYPASSRLS, so row level security always applies.
# Must be a different role from DATABASE_URL.
APP_DATABASE_URL=postgresql://rythu_web:CHANGE_ME@127.0.0.1:5432/rythudirect

# Signs session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates all existing sessions.
JWT_SECRET=CHANGE_ME_generate_a_long_random_string

# Development only. Set to true to switch off rate limiting while the
# end-to-end script drives many sign-ins in a minute. Refused when
# NODE_ENV=production, so it can never weaken a real deployment.
RATE_LIMIT_DISABLED=false

# Public origin of the SPA. Used for CORS allow-list and for links in emails.
APP_URL=http://localhost:12000
API_URL=http://localhost:12001

# ----------------------------------------------------------------------------
# Email (OPTIONAL — verification and reset links are logged to console when unset)
# ----------------------------------------------------------------------------
# When these are absent, transactional email is written to the server log with
# a clear [EMAIL:DISABLED] prefix instead of being sent. No user-facing flow
# breaks; the link is simply printed for the operator.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=RythuDirect <no-reply@example.com>

# ----------------------------------------------------------------------------
# Maps (OPTIONAL — falls back to state/district list search when unset)
# ----------------------------------------------------------------------------
# Browser key. Restrict by HTTP referrer and to these APIs only:
#   Maps JavaScript API, Places API, Geocoding API, Distance Matrix API
VITE_GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------------------------
# Payments (OPTIONAL — checkout shows an explicit "not configured" state)
# ----------------------------------------------------------------------------
# SECRET. Server-side only. Never expose to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set to the value you enter in the Razorpay dashboard webhook config.
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# AI crop image assessment (OPTIONAL — feature is hidden when unset)
# ----------------------------------------------------------------------------
# SECRET. Server-side only.
AI_VISION_API_KEY=
AI_VISION_MODEL=gpt-4o-mini
AI_VISION_ENABLED=false

# ----------------------------------------------------------------------------
# SMS / OTP (OPTIONAL — phone OTP is hidden when unset)
# ----------------------------------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# ----------------------------------------------------------------------------
# Market price data (OPTIONAL — manual entry works without any of these)
# ----------------------------------------------------------------------------
# Agmarknet has no public REST API. Data is ingested by an operator or an
# approved partner feed; see INTEGRATION_SETUP.md section G.
AGMARKNET_API_KEY=
AGMARKNET_API_URL=
